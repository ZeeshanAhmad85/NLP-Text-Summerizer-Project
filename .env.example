# Application Environment Configuration (Sample)
# Copy this file to .env and adjust variables as needed for local execution.
# NEVER commit sensitive API keys or credentials to version control.

# Server settings
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=INFO

# Model and inference configuration
# Leave empty to use auto-discovery from artifacts/model_trainer or fallback to pretrained
# MODEL_CHECKPOINT_PATH=artifacts/model_trainer/pegasus-samsum-model
# TOKENIZER_PATH=artifacts/model_trainer/tokenizer
# DEVICE=cpu # 'cpu' or 'cuda'

# AWS Deployment Credentials (Optional - for EC2/ECR deployment)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_ECR_LOGIN_URI=
# ECR_REPOSITORY_NAME=
